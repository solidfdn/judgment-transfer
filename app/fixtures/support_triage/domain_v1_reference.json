{
  "schema_version": "1.0",
  "domain_id": "support_triage",
  "version": 1,
  "title": "Business service request triage",
  "goal": "Route service requests by verified business impact and hold missing evidence.",
  "input_fields": [
    {
      "field_id": "verified",
      "label": "verified",
      "type": "boolean",
      "description": "The incident evidence is verified.",
      "required": true
    },
    {
      "field_id": "interrupted",
      "label": "interrupted",
      "type": "boolean",
      "description": "Service interruption exists.",
      "required": true
    },
    {
      "field_id": "affected_users",
      "label": "affected users",
      "type": "number",
      "description": "Number of affected users.",
      "required": true
    },
    {
      "field_id": "time_critical",
      "label": "time critical",
      "type": "boolean",
      "description": "A time-critical business task is blocked.",
      "required": true
    },
    {
      "field_id": "hours_to_deadline",
      "label": "hours to deadline",
      "type": "number",
      "description": "Hours until the business deadline.",
      "required": true
    },
    {
      "field_id": "workaround",
      "label": "workaround",
      "type": "boolean",
      "description": "A viable workaround exists.",
      "required": true
    }
  ],
  "state_fields": [
    {
      "field_id": "status",
      "label": "status",
      "type": "string",
      "description": "Current isolated case status.",
      "required": true
    }
  ],
  "actions": [
    {
      "action_id": "route_high",
      "label": "route high",
      "description": "Apply the declared result to this isolated case only.",
      "effects": [
        {
          "field_id": "status",
          "value": "HIGH_PRIORITY"
        }
      ],
      "terminal": true
    },
    {
      "action_id": "route_standard",
      "label": "route standard",
      "description": "Apply the declared result to this isolated case only.",
      "effects": [
        {
          "field_id": "status",
          "value": "STANDARD_PRIORITY"
        }
      ],
      "terminal": true
    },
    {
      "action_id": "hold_case",
      "label": "hold case",
      "description": "Apply the declared result to this isolated case only.",
      "effects": [
        {
          "field_id": "status",
          "value": "HELD"
        }
      ],
      "terminal": true
    }
  ],
  "rules": [
    {
      "rule_id": "sup_critical",
      "priority": 10,
      "statement": "A verified interruption affecting fewer than 20 users is high priority if it blocks a time-critical business task, the deadline is within two hours, and no viable workaround exists. Otherwise, when every relevant fact is confirmed, route it to standard priority. If any relevant fact is missing, hold it.",
      "when": {
        "all": [
          {
            "field_id": "verified",
            "operator": "eq",
            "value": true
          },
          {
            "field_id": "interrupted",
            "operator": "eq",
            "value": true
          },
          {
            "field_id": "affected_users",
            "operator": "lt",
            "value": 20
          },
          {
            "field_id": "time_critical",
            "operator": "eq",
            "value": true
          },
          {
            "field_id": "hours_to_deadline",
            "operator": "gte",
            "value": 0
          },
          {
            "field_id": "hours_to_deadline",
            "operator": "lte",
            "value": 2
          },
          {
            "field_id": "workaround",
            "operator": "eq",
            "value": false
          }
        ],
        "any": []
      },
      "action_id": "route_high",
      "source_refs": [
        {
          "source_id": "support_teaching",
          "version_hash": "54cb7bc1aa279126faf0ceb2987dce15371dffb66860c81a422316f482ec3837",
          "locator": "human:1",
          "quote": "A verified interruption affecting fewer than 20 users is high priority if it blocks a time-critical business task, the deadline is within two hours, and no viable workaround exists. Otherwise, when every relevant fact is confirmed, route it to standard priority. If any relevant fact is missing, hold it."
        }
      ],
      "approved_by": "fixture-author"
    },
    {
      "rule_id": "sup_wide",
      "priority": 30,
      "statement": "Verified interruption affects at least 20 users.",
      "when": {
        "all": [
          {
            "field_id": "verified",
            "operator": "eq",
            "value": true
          },
          {
            "field_id": "interrupted",
            "operator": "eq",
            "value": true
          },
          {
            "field_id": "affected_users",
            "operator": "gte",
            "value": 20
          }
        ],
        "any": []
      },
      "action_id": "route_high",
      "source_refs": [
        {
          "source_id": "support_sop",
          "version_hash": "58b0a4f4d1b8d84a09ca48648e1f03b586fad9ac70f182bd191fe2c68f194a94",
          "locator": "line:2",
          "quote": "A verified service interruption affecting at least 20 users is high priority."
        }
      ],
      "approved_by": "fixture-author"
    },
    {
      "rule_id": "sup_available",
      "priority": 90,
      "statement": "Verified service is available.",
      "when": {
        "all": [
          {
            "field_id": "verified",
            "operator": "eq",
            "value": true
          },
          {
            "field_id": "interrupted",
            "operator": "eq",
            "value": false
          }
        ],
        "any": []
      },
      "action_id": "route_standard",
      "source_refs": [
        {
          "source_id": "support_sop",
          "version_hash": "58b0a4f4d1b8d84a09ca48648e1f03b586fad9ac70f182bd191fe2c68f194a94",
          "locator": "line:3",
          "quote": "A verified available service with no reported interruption is standard priority."
        }
      ],
      "approved_by": "fixture-author"
    },
    {
      "rule_id": "sup_workaround",
      "priority": 50,
      "statement": "A fully confirmed smaller interruption without the urgent exception is standard priority.",
      "when": {
        "all": [
          {
            "field_id": "verified",
            "operator": "eq",
            "value": true
          },
          {
            "field_id": "interrupted",
            "operator": "eq",
            "value": true
          },
          {
            "field_id": "affected_users",
            "operator": "lt",
            "value": 20
          },
          {
            "field_id": "time_critical",
            "operator": "exists",
            "value": null
          },
          {
            "field_id": "hours_to_deadline",
            "operator": "exists",
            "value": null
          },
          {
            "field_id": "workaround",
            "operator": "exists",
            "value": null
          },
          {
            "field_id": "workaround",
            "operator": "eq",
            "value": true
          }
        ],
        "any": []
      },
      "action_id": "route_standard",
      "source_refs": [
